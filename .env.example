# ── Site ──────────────────────────────────────────────────────────────
# Public base URL of the deployed site (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to sign admin JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters. Never share or commit it.
JWT_SECRET=change-me-to-a-long-random-string

# ── Database (MongoDB Atlas, free M0) ──────────────────────────────────
# Create a free cluster at https://cloud.mongodb.com, add a database user,
# allow network access (0.0.0.0/0 for Vercel/Netlify, or your IP), then paste
# the connection string. The database name is part of the URI path.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# ── Admin account ─────────────────────────────────────────────────────
# Used by `npm run seed` to create the admin (password is bcrypt-hashed
# into MongoDB; plaintext is never stored). Also used as a first-login
# fallback if no admin document exists yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
